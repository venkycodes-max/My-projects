    print("2. View Destinations")
    print("3. View Food Options")
    print("4. View Tourist Records")
    print("5. Search Tourist")
    print("6. View Emergency & Transport Services")
    print("0. Exit")

    print("=" * 65)

def view_destinations():

    connection = get_connection(DB_NAME)

    if connection is None:
        return

    cursor = connection.cursor()

    try:
        cursor.execute("""
            SELECT destination_id,
                   destination_name,
                   temperature,
                   package_range
            FROM destinations
            ORDER BY destination_id
        """)

        records = cursor.fetchall()

        print_header("AVAILABLE DESTINATIONS")

        print(
            f"{'Code':<8}"
            f"{'Destination':<18}"
            f"{'Temperature':<15}"
            f"{'Package Range'}"
        )

        print("-" * 65)

        for row in records:
            print(
                f"{row[0]:<8}"
                f"{row[1]:<18}"
                f"{str(row[2]) + ' °C':<15}"
                f"{row[3]}"
            )

    except Error as e:
        print("Error:", e)

    finally:
