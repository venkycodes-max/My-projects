        connection.close()


def get_destination(destination_id):

    connection = get_connection(DB_NAME)

    if connection is None:
        return None

    cursor = connection.cursor()

    try:
        cursor.execute("""
            SELECT destination_id,
                   destination_name,
                   temperature,
                   package_range,
                   emergency_services,
                   transport_services
            FROM destinations
            WHERE destination_id = %s
        """, (destination_id,))

        return cursor.fetchone()

    except Error as e:
        print("Error:", e)
        return None

    finally:
        cursor.close()
        connection.close()

