def get_integer(prompt):

    while True:
        try:
            return int(input(prompt))
        except ValueError:
            print("Please enter a valid number.")


def get_non_empty_input(prompt):

    while True:
        value = input(prompt).strip()

        if value:
            return value

        print("This field cannot be empty.")


def get_yes_no(prompt):

    while True:
        value = input(prompt).strip().upper()

        if value == "Y":
            return "Yes"

        if value == "N":
            return "No"

        print("Please enter Y or N.")

def clothing_recommendation(temperature):

    if temperature < 25:
        return (
            "Sweater, jacket, gloves, scarf, "
            "water-resistant coat, boots and warm socks"
        )

    return (
        "Light-coloured cotton/linen clothing, "
        "loose-weave fabrics, sunscreen and adequate hydration"
    )

def register_tourist():

    print_header("TOURIST REGISTRATION")

    name = get_non_empty_input("Enter name: ")
    contact = get_non_empty_input("Enter contact number: ")

    view_destinations()

    while True:
        destination_id = get_integer(
            "\nEnter destination code: "
        )

        destination = get_destination(destination_id)

        if destination:
            break

        print("Invalid destination code.")

    view_food_options()

    while True:
        food_code = get_integer(
            "\nEnter food code: "
        )

        food = get_food(food_code)

        if food:
            break

        print("Invalid food code.")

    accommodation = get_non_empty_input(
        "Enter accommodation preference: "
    )

    translator = get_yes_no(
        "Do you require a translator? (Y/N): "
    )

    entertainment = get_non_empty_input(
        "Enter entertainment/recreational preferences: "
    )

    transport = get_non_empty_input(
        "Enter transport preference: "
    )

    discount = random.randint(5, 20)

    temperature = float(destination[2])

    connection = get_connection(DB_NAME)

    if connection is None:
        return

    cursor = connection.cursor()

    try:
        query = """
            INSERT INTO tourists
            (
                name,
                contact_number,
                destination_id,
                food_code,
                accommodation,
                translator_required,
                entertainment_preferences,
                transport_preference,
                discount_percent
            )
            VALUES (%s, %s, %s, %s, %s, %s, %s, %s, %s)
        """

        values = (
            name,
            contact,
            destination_id,
            food_code,
            accommodation,
            translator,
            entertainment,
            transport,
            discount
        )

        cursor.execute(query, values)
        connection.commit()

        print_header("TOURIST INFORMATION")

        print(f"Name                  : {name}")
        print(f"Contact Number        : {contact}")
        print(f"Visiting Place        : {destination[1]}")
        print(f"Food Choice            : {food[1]}")
        print(f"Accommodation         : {accommodation}")
        print(f"Translator Required   : {translator}")
        print(f"Temperature            : {temperature} °C")
        print(f"Entertainment          : {entertainment}")
        print(f"Transport              : {transport}")
        print(f"Suggested Package     : {destination[3]}")
        print(f"Discount               : {discount}%")

        print("\nRecommended Clothing:")
        print(clothing_recommendation(temperature))

        print("\nTourist registration completed successfully.")

    except Error as e:
        connection.rollback()
        print("Unable to register tourist:", e)

    finally:
        cursor.close()
        connection.close()

def view_tourists():

    connection = get_connection(DB_NAME)

    if connection is None:
        return

    cursor = connection.cursor()

    try:
        query = """
            SELECT
                t.tourist_id,
                t.name,
                t.contact_number,
                d.destination_name,
                f.food_type,
                t.accommodation,
                t.translator_required,
                t.transport_preference,
                t.discount_percent
            FROM tourists t
            JOIN destinations d
                ON t.destination_id = d.destination_id
            JOIN food_preferences f
                ON t.food_code = f.food_code
            ORDER BY t.tourist_id
        """

        cursor.execute(query)
        records = cursor.fetchall()

        print_header("REGISTERED TOURISTS")

        if not records:
            print("No tourist records found.")
            return

        for row in records:
            print(f"\nTourist ID          : {row[0]}")
            print(f"Name                : {row[1]}")
            print(f"Contact             : {row[2]}")
            print(f"Destination         : {row[3]}")
            print(f"Food                : {row[4]}")
            print(f"Accommodation       : {row[5]}")
            print(f"Translator          : {row[6]}")
            print(f"Transport           : {row[7]}")
            print(f"Discount            : {row[8]}%")
            print("-" * 65)

    except Error as e:
        print("Error:", e)

    finally:
        cursor.close()
        connection.close()

def search_tourist():

    print_header("SEARCH TOURIST")

    name = get_non_empty_input(
        "Enter tourist name to search: "
    )

    connection = get_connection(DB_NAME)

    if connection is None:
        return

    cursor = connection.cursor()

    try:
        query = """
            SELECT
                t.tourist_id,
                t.name,
                t.contact_number,
                d.destination_name,
                f.food_type,
                t.accommodation,
                t.translator_required,
                t.transport_preference,
                t.discount_percent
            FROM tourists t
            JOIN destinations d
                ON t.destination_id = d.destination_id
            JOIN food_preferences f
                ON t.food_code = f.food_code
            WHERE t.name LIKE %s
        """

        cursor.execute(query, (f"%{name}%",))
        records = cursor.fetchall()

        if not records:
            print("No tourist found.")
            return

        for row in records:
            print("\nTourist ID        :", row[0])
            print("Name              :", row[1])
            print("Contact           :", row[2])
            print("Destination       :", row[3])
            print("Food              :", row[4])
            print("Accommodation     :", row[5])
            print("Translator        :", row[6])
            print("Transport         :", row[7])
            print("Discount          :", str(row[8]) + "%")

    except Error as e:
        print("Search error:", e)

    finally:
        cursor.close()
        connection.close()


def services_information():

    view_destinations()

    while True:
        destination_id = get_integer(
            "\nEnter destination code: "
        )

        destination = get_destination(destination_id)

        if destination:
            break

        print("Invalid destination code.")

    print_header(f"SERVICES — {destination[1]}")

    print("\nEmergency Services:")
    print(destination[4])

    print("\nTransport Services:")
    print(destination[5])

def main():

    print("\n" + "=" * 65)
    print("JAVT TOURS AND TRAVELS".center(65))
    print("Tourists Information System".center(65))
    print("=" * 65)

    if not setup_database():
        print("\nUnable to initialize the database.")
        print("Please check your MySQL server and credentials.")
        return

    while True:

        display_main_menu()

        choice = input("Enter your choice: ").strip()

        if choice == "1":
            register_tourist()

        elif choice == "2":
            view_destinations()

        elif choice == "3":
            view_food_options()

        elif choice == "4":
            view_tourists()

        elif choice == "5":
            search_tourist()

        elif choice == "6":
            services_information()

        elif choice == "0":
            print("\nThank you for using JAVT Tours and Travels!")
            print("Have a safe and enjoyable journey!")
            break

        else:
            print("\nInvalid choice. Please select a valid option.")


if __name__ == "__main__":
    main()
